<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HexWars.NetServer</AssemblyName>
    <RootNamespace>HexWars.NetServer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HexWars.Engine\HexWars.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <!-- The schema travels inside the assembly: a container deploy has no SQL files to copy and the
       migrations can never drift from the binary that applies them. -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence\Migrations\*.sql" LogicalName="HexWars.NetServer.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HexWars.NetServer.Tests" />
  </ItemGroup>

</Project>
