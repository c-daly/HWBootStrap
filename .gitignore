# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/

# Exception: the built WebGL client lives under the server's wwwroot and MUST be committed for
# repo-based (Render/Railway) deploys — the cloud builder can't run Unity to produce it.
# (The raw Unity output at /Build stays ignored; copy it here to ship it.)
!engine/HexWars.NetServer/wwwroot/Build/
!engine/HexWars.NetServer/wwwroot/Build/**
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# JetBrains Rider project settings
.idea/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
# Exception: the standalone .NET engine/server projects under engine/ are real source (not Unity-generated)
# and must be tracked so repo-based deploys can build the server.
!engine/**/*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS / editor cruft
.DS_Store
Thumbs.db

# .NET engine build output (standalone HexWars.Engine solution under engine/)
[Bb]in/
[Oo]bj/
engine/**/bin/
engine/**/obj/

# Local Claude Code tooling (workflow scripts, etc.)
.claude/

# Local Superpowers brainstorming previews and transient preview-server state
.superpowers/

# Local isolated feature worktrees
.worktrees/

# Engine DLL placed in Unity is a build artifact — regenerate with engine/build-to-unity.ps1
Assets/HexWars/Plugins/HexWars.Engine.dll
Assets/HexWars/Plugins/HexWars.Engine.dll.meta

# Local ML environments, experiments, trackers, and generated replays
__pycache__/
*.py[cod]
.pytest_cache/
python/winenv/
python/runs/
python/wandb/
python/events.out.tfevents.*
/replays/*.replay

# Generated imitation-dataset evidence. Keep any hand-authored fixtures/source below datasets trackable.
/python/datasets/annihilation-imitation-v1/manifest.json
/python/datasets/annihilation-imitation-v1/games.jsonl
/python/datasets/annihilation-imitation-v1/shards/
/python/datasets/annihilation-imitation-v1/replays/

# Generated end-to-end imitation smoke evidence (identity-bound but never committed).
/python/panels/annihilation-imitation-v1/evidence/
# Vendor asset kits: local-only, never committed (1.2GB model kit; the game copies the few
# files it uses into Assets/HexWars/Audio, which IS tracked). Unity crash-recovery snapshots too.
Assets/Creepy_Cat/
Assets/Creepy_Cat.meta
Assets/Deep_In_Space/
Assets/Deep_In_Space.meta
Assets/_Recovery/
Assets/_Recovery.meta
Assets/Scifi Guns SFX Pack/
Assets/Scifi Guns SFX Pack.meta
